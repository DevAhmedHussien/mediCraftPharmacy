# Absolute origin used for canonical URLs, the sitemap, and — critically —
# Open Graph image URLs. Social crawlers require absolute URLs, so if this is
# wrong the shared link renders with no preview image.
#
# Set this to the live domain on the production deployment.
# On Vercel, preview deployments fall back to VERCEL_URL automatically.
NEXT_PUBLIC_SITE_URL=https://medicraftpharmacy.com
