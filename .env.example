# ===========================================================================
# MediCraft Pharmacy — environment
#
# Every variable here is parsed and validated by lib/env.ts at boot. A missing
# or malformed value fails the process with a readable list rather than
# throwing inside the first request that happens to need it.
#
# Copy to .env and fill in. Never commit .env.
# ===========================================================================

NODE_ENV="development"

# --- Database --------------------------------------------------------------
# Postgres 14+. Prisma 7 reads this through prisma.config.ts for migrations
# and through the pg driver adapter at runtime (lib/db.ts).
DATABASE_URL="postgresql://USER@127.0.0.1:5432/medicraft?schema=public"

# --- App -------------------------------------------------------------------
# Absolute origin. Used for email links and OAuth/DocuSign return URLs.
APP_URL="http://localhost:3000"

# --- Secrets ---------------------------------------------------------------
# Auth.js JWT signing key. The token carries `role` and `permissions`, so
# forging one is a privilege escalation — rotate it and every session ends.
#   openssl rand -base64 32
AUTH_SECRET=""

# AES-256-GCM key for DEA numbers, NPIs, state licence numbers and EINs.
# Must be base64 of EXACTLY 32 bytes. Changing it makes existing ciphertext
# undecryptable — rotating means re-encrypting, not just replacing.
#   openssl rand -base64 32
FIELD_ENCRYPTION_KEY=""

# Mixed into the daily visitor hash for analytics. Rotating it un-links every
# historical visitor, which is the privacy property rather than a bug.
#   openssl rand -base64 24
ANALYTICS_SALT=""

# --- Storage ---------------------------------------------------------------
# "local" writes to LOCAL_UPLOAD_DIR and serves through an authenticated route
# handler; "s3" presigns direct browser uploads to a private bucket. The code
# path is identical either way — only where the bytes live changes.
STORAGE_DRIVER="local"
LOCAL_UPLOAD_DIR=".uploads"

# Required when STORAGE_DRIVER="s3". The bucket must be PRIVATE: nothing in
# this codebase sets a public ACL, and every read is a presigned GET that
# expires in five minutes.
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Set only for MinIO / LocalStack / Cloudflare R2. Leave blank for real AWS.
S3_ENDPOINT=""
S3_FORCE_PATH_STYLE="false"

# --- Email -----------------------------------------------------------------
# "console" writes rendered emails to the log instead of sending — the default
# until a provider key exists, so no half-built flow can email a real partner.
EMAIL_DRIVER="console"
RESEND_API_KEY=""
EMAIL_FROM="MediCraft Pharmacy <partners@medicraftpharmacy.com>"
EMAIL_REPLY_TO="support@medicraftpharmacy.com"

# --- Debugging -------------------------------------------------------------
# Logs every SQL statement Prisma runs. Off by default; it is very loud.
PRISMA_LOG_QUERIES="false"

# --- GoHighLevel ----------------------------------------------------------
# Public contact enquiries are upserted into the CRM and tagged. Both the
# token and the location must be set together, or the app refuses to boot.
# The token is a Private Integration Token (starts "pit-"), scoped to one
# sub-account; the location id is the sub-account it belongs to.
GHL_API_TOKEN=""
GHL_LOCATION_ID=""
# Optional. Defaults shown.
# GHL_API_BASE="https://services.leadconnectorhq.com"
# GHL_API_VERSION="2021-07-28"
# GHL_CONTACT_TAG="contact_us_form"
#
# CRM_SYNC: partner pipeline transitions are mirrored into GoHighLevel via the
# CrmOutbox queue, drained by the same scheduled job as the email outbox
# (POST /api/cron/email). No extra configuration — if GHL_API_TOKEN and
# GHL_LOCATION_ID are set, the sync runs; if not, rows are never enqueued.

# --- Calendar and video (pricing call) -------------------------------------
# "manual" books the call without touching a diary and uses whatever link an
# admin types into "Where". "google" reads free/busy to suggest real gaps and
# attaches a Google Meet link when the applicant picks a time.
CALENDAR_DRIVER="manual"
#
# For "google": a service account with the Calendar API enabled.
# GOOGLE_SERVICE_ACCOUNT_EMAIL="medicraft-calendar@project.iam.gserviceaccount.com"
# The PEM from the service-account JSON, newlines escaped as \n.
# GOOGLE_SERVICE_ACCOUNT_KEY="-----BEGIN PRIVATE KEY-----\nMII...\n-----END PRIVATE KEY-----\n"
#
# A Meet link needs MORE than a service account: Google issues conference data
# for a Workspace USER, not a robot. Grant the service account domain-wide
# delegation for https://www.googleapis.com/auth/calendar.events and name the
# user it impersonates here. Without it, events are still created — just
# without a Meet link.
# GOOGLE_CALENDAR_SUBJECT="partners@medicraftpharmacy.com"
# GOOGLE_CALENDAR_ID="primary"
# CALENDAR_TIMEZONE="America/New_York"

# --- E-signature ------------------------------------------------------------
# "internal" captures a typed name in-app (valid under E-SIGN/UETA, no
# third-party certificate). "signeasy" sends the rendered agreement out for
# signature; "docusign" is declared but its driver still throws.
SIGNATURE_DRIVER="internal"
#
# For "signeasy": both of these are required or the app refuses to boot.
# SIGNEASY_API_KEY=""
# SIGNEASY_CLIENT_ID=""
# Signs the completion webhook at POST /api/webhooks/signeasy. Without it the
# route rejects every delivery, which is the safe default.
# SIGNEASY_WEBHOOK_SECRET=""
# SIGNEASY_API_BASE="https://api.signeasy.com/v1"
